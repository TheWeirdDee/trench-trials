{
  "name": "trench-trials",
  "version": "1.1.0",
  "private": true,
  "description": "Trench Trials — Unmask. A market game built from real Nansen data.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:setup": "tsx scripts/test-db-setup.ts",
    "migrate": "node-pg-migrate --envPath .env.local",
    "migrate:up": "tsx scripts/migrate.ts",
    "migrate:down": "node-pg-migrate down --envPath .env.local",
    "import:verified-round": "tsx scripts/import-verified-round.ts",
    "generate:replay": "tsx scripts/generate-replay.ts",
    "assign:daily": "tsx scripts/assign-daily.ts",
    "review:round": "tsx scripts/review-round.ts",
    "rebuild:round": "tsx scripts/rebuild-round.ts",
    "verify:rebuilt": "tsx scripts/verify-rebuilt.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "export:bundle": "tsx scripts/export-verified-bundle.ts",
    "check:links": "tsx scripts/check-links.ts",
    "invalidate:live": "tsx scripts/invalidate-live-round.ts",
    "reassign:daily": "tsx scripts/reassign-daily.ts",
    "create:live": "tsx scripts/create-live-round.ts",
    "resolve:live": "tsx scripts/resolve-live-round.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "node-pg-migrate": "^7.7.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
