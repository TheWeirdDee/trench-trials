# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Nansen API key — required. Get one at https://app.nansen.ai (Settings > API).
# Trench Trials has no fallback/demo/mock data path: without a valid key with access
# to the historical screener, historical flow summary, and a historical price/OHLCV
# endpoint, round generation fails closed rather than substituting fake data.
NANSEN_API_KEY=

# Postgres connection string (Supabase or any hosted Postgres works). Supabase's session
# pooler (5432) admits 15 clients in total across all processes; deploy with the
# transaction pooler (6543). See SETUP.md.
DATABASE_URL=

# Signs guest session cookies. Required in production: at least 32 random characters
# (e.g. `openssl rand -hex 32`). Changing it starts every guest over.
SESSION_SECRET=

# Optional database settings.
# DB_POOL_MAX=10                      # pool size per process; budget it across processes
# DATABASE_SSL=require                # or "disable" for a local Postgres without TLS
# DATABASE_SSL_CA_FILE=               # CA bundle path; when set, the server certificate is verified
# TT_TIMING=1                         # log per-request DB timings (Server-Timing header outside production)

# Base URL of the running app.
APP_URL=http://localhost:3000

# Hard cap on Nansen HTTP requests (retries included) per operation. Unset = default.
# Values must be integers 1–10; a value below what the operation needs is refused
# before any request. See docs/LIVE-REAL-RUNBOOK.md.
# Live create needs 2 (default 3); Live resolve needs 3 (default 4).
MAX_NANSEN_CALLS_PER_LIVE_CREATE=
MAX_NANSEN_CALLS_PER_LIVE_RESOLVE=

# Shared secret for internal routes: POST /api/internal/daily/assign,
# POST /api/internal/live/create, POST /api/internal/live/resolve, GET /api/internal/usage.
# Unset means every internal request is refused. Generate a long random string.
CRON_SECRET=
