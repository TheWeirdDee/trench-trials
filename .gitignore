# --- Secrets / credentials: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*credential*
*secret*

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js / build output ---
.next/
out/
build/
dist/

# --- Testing ---
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Misc ---
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Local env files ---
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- Logs that could contain request/response data ---
*.log
logs/

# --- Any local scratch/evidence dumps that might contain raw provider responses ---
/scratch/
/tmp/

# --- Raw Nansen responses: private evidence, never committed (redistribution) ---
.nansen-raw/

# --- Local-only review material and scratch tooling ---
/artifacts/
.audit-tmp/
*.dump
*.p12
*.pfx
